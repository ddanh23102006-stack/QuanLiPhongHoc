@using QuanLiPhongHoc.Web.Models.Domain
@{
    ViewData["Title"] = "Trung tâm Quản trị hệ thống";
    var logs = ViewBag.Logs as IEnumerable<NhatKyHeThong> ?? [];
    var today = DateTime.Today;
}

<!-- Breadcrumb Navigation -->
<nav class="flex items-center gap-2 mb-4 text-on-surface-variant font-label-md text-label-md">
    <a class="hover:text-primary transition-colors flex items-center gap-1" href="/">
        <span class="material-symbols-outlined text-[16px]">home</span>
        Trang chủ
    </a>
    <span class="material-symbols-outlined text-[14px] text-outline">chevron_right</span>
    <span class="text-primary font-semibold">Trung tâm Quản trị</span>
</nav>

<!-- Welcome Strip -->
<div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 mb-4 border-b border-outline-variant/80 gap-2">
    <div class="flex items-center gap-2">
        <h1 class="font-headline-md text-headline-md text-primary font-bold">Xin chào, @((string?)ViewBag.HoTen ?? User.Identity?.Name)!</h1>
        <span class="text-on-surface-variant text-sm font-normal">• Quản trị viên hệ thống</span>
    </div>
    <div class="text-xs text-on-surface-variant flex items-center gap-2">
        <span class="material-symbols-outlined text-[16px] text-primary">security</span>
        <span class="font-semibold text-primary">Hệ thống bảo mật</span>
    </div>
</div>

<!-- Quick Access Section -->
<section class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
    <a href="/NguoiDung" class="bg-surface-container-lowest border border-outline-variant/70 hover:border-primary rounded-xl p-6 flex items-center gap-5 transition-all group shadow-sm hover:shadow">
        <div class="w-14 h-14 rounded-full bg-surface-container flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-white transition-colors shrink-0">
            <span class="material-symbols-outlined text-[32px]">manage_accounts</span>
        </div>
        <div>
            <h4 class="font-bold text-base text-slate-800 group-hover:text-primary transition-colors">Quản lý Tài khoản & Phân quyền</h4>
            <p class="text-xs text-on-surface-variant mt-1">Thiết lập vai trò, cấp quyền truy cập và quản lý người dùng.</p>
        </div>
    </a>
    <a href="/NhatKy" class="bg-surface-container-lowest border border-outline-variant/70 hover:border-primary rounded-xl p-6 flex items-center gap-5 transition-all group shadow-sm hover:shadow">
        <div class="w-14 h-14 rounded-full bg-surface-container flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-white transition-colors shrink-0">
            <span class="material-symbols-outlined text-[32px]">list_alt</span>
        </div>
        <div>
            <h4 class="font-bold text-base text-slate-800 group-hover:text-primary transition-colors">Nhật ký hoạt động</h4>
            <p class="text-xs text-on-surface-variant mt-1">Truy vết toàn bộ thao tác và thay đổi trên hệ thống.</p>
        </div>
    </a>
</section>

<!-- Recent Logs Table -->
<section class="bg-surface-container-lowest border border-outline-variant/80 rounded-xl shadow-sm overflow-hidden">
    <div class="px-5 py-3 border-b border-outline-variant/60 flex items-center justify-between">
        <h2 class="font-bold text-slate-800 flex items-center gap-2">
            <span class="material-symbols-outlined text-primary text-[20px]">history</span>
            Nhật ký hệ thống gần đây
        </h2>
        <a href="/NhatKy" class="text-xs text-primary hover:underline font-semibold">Xem toàn bộ nhật ký ›</a>
    </div>
    <div class="p-0 overflow-x-auto">
        <table class="w-full text-sm text-left">
            <thead>
                <tr class="bg-surface-container-low/50 text-on-surface-variant">
                    <th class="px-5 py-3 font-semibold">Thời gian</th>
                    <th class="px-5 py-3 font-semibold">Hành động</th>
                    <th class="px-5 py-3 font-semibold">Đối tượng</th>
                    <th class="px-5 py-3 font-semibold">Người thực hiện</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-outline-variant/40">
                @if (!logs.Any())
                {
                    <tr>
                        <td colspan="4" class="px-5 py-8 text-center text-on-surface-variant italic">Chưa có hoạt động nào được ghi nhận.</td>
                    </tr>
                }
                @foreach (var l in logs)
                {
                    <tr class="hover:bg-surface-container-low/30 transition-colors">
                        <td class="px-5 py-3 text-on-surface-variant">@l.ThoiGian.ToString("HH:mm:ss dd/MM")</td>
                        <td class="px-5 py-3 font-semibold">@NhatKyCatalog.LabelHanhDong(l.LoaiHanhDong)</td>
                        <td class="px-5 py-3">@NhatKyCatalog.LabelDoiTuong(l.DoiTuongTacDong)</td>
                        <td class="px-5 py-3 text-primary">@l.NguoiThucHien?.HoTen</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>