          </label>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <label class="block text-sm font-semibold">
              Lọc loại phòng
              <select id="editLoaiPhongLoc" class="mt-1 w-full rounded-lg border border-outline-variant bg-surface-container-low px-3 py-2">
                <option value="">Tất cả loại phòng</option>
                <option value="theory">Phòng lý thuyết</option>
                <option value="practice">Phòng thực hành</option>
                <option value="sports">Sân thể dục</option>
              </select>
            </label>
            <label class="block text-sm font-semibold">
              Đổi phòng học / sân bãi
              <select name="MaPhong" id="editMaPhong" required class="mt-1 w-full rounded-lg border border-outline-variant bg-surface-container-low px-3 py-2">
                <option value="">Chọn phòng học / sân bãi</option>
                @foreach (var p in phongOptions.Where(x => NhomPhong(x) != "other"))
                {
                  <option value="@p.MaPhong" data-kind="@NhomPhong(p)">@p.CodePhong · @p.ToaNha?.CodeToaNha · @p.SucChua chỗ</option>
                }
              </select>
            </label>
          </div>
          <label class="block text-sm font-semibold">
            Trạng thái ca học
            <select name="TrangThaiHoatDong" id="editTrangThaiHoatDong" class="mt-1 w-full rounded-lg border border-outline-variant bg-surface-container-low px-3 py-2">
              <option value="true">Chính khóa (Bình thường)</option>
              <option value="false">Báo nghỉ</option>
            </select>
          </label>
          <label class="block text-sm font-semibold">
            Ghi chú điều phối
            <textarea name="GhiChuDieuPhoi" id="editGhiChuDieuPhoi" maxlength="500" rows="2" class="mt-1 w-full rounded-lg border border-outline-variant bg-surface-container-low px-3 py-2"></textarea>
          </label>
          <p id="editConflictBox" class="hidden rounded-lg bg-error-container p-3 text-sm text-on-error-container"></p>
          <div class="flex flex-wrap items-center justify-between gap-2 pt-1">
            <button type="submit" form="cancelLichForm"
                    id="editCancelButton"
                    class="px-4 py-2 rounded-lg bg-error-container text-on-error-container font-semibold"
                    onclick="return confirm('Chuyển ca này sang trạng thái báo nghỉ?');">
              <span class="material-symbols-outlined text-[18px] align-middle">delete</span> Hủy ca này
            </button>
            <div class="flex gap-2">
              <button type="button" onclick="document.getElementById('lichEditModal').close()"
                      class="px-4 py-2 rounded-lg bg-surface-container text-on-surface font-semibold">Hủy bỏ</button>
              <button type="submit" class="px-4 py-2 rounded-lg bg-primary text-on-primary font-bold">
                <span class="material-symbols-outlined text-[18px] align-middle">check</span> Lưu thay đổi
              </button>
            </div>
          </div>
        </div>
      </form>
    </dialog>
    <form id="cancelLichForm" asp-action="Cancel" method="post" class="hidden">
      @Html.AntiForgeryToken()
      <input type="hidden" name="id" id="cancelLichId" />
      <input type="hidden" name="week" value="@weekStart.ToString("yyyy-MM-dd")" />
      <input type="hidden" name="building" value="@(building?.ToString() ?? "")" />
      <input type="hidden" name="loai" value="@loai" />
      <input type="hidden" name="Page" value="@(page)" />
    </form>
}

<!-- Cấu hình giờ & Ca học: sửa khung giờ, thêm ca mới và lưu vào App_Data/cau-hinh-ca-hoc.json -->
@if (canEdit)
{
