@section Scripts {
<script>
    const editModal = document.getElementById('lichEditModal');
    const editForm = document.getElementById('editLichForm');
    const roomFilter = document.getElementById('editLoaiPhongLoc');
    const roomSelect = document.getElementById('editMaPhong');
    const conflictBox = document.getElementById('editConflictBox');
    let conflictCheckId = 0;
    let editSubmitting = false;

    function filterEditRooms(preferredRoom) {
        const kind = roomFilter.value;
        const options = Array.from(roomSelect.options).slice(1);
        options.forEach(option => {
            option.hidden = !!kind && option.dataset.kind !== kind;
        });
        const requestedRoom = preferredRoom === undefined ? roomSelect.value : preferredRoom;
        const selected = options.find(option => option.value === requestedRoom && !option.hidden);
        if (selected) {
            roomSelect.value = selected.value;
        } else if (preferredRoom !== undefined) {
            roomSelect.value = '';
        } else {
            roomSelect.value = options.find(option => !option.hidden)?.value || '';
        }
    }

    async function checkEditConflict() {
        const requestId = ++conflictCheckId;
        const active = document.getElementById('editTrangThaiHoatDong').value === 'true';
        const roomId = roomSelect.value;
        if (!active || !roomId) {
            conflictBox.classList.add('hidden');
            conflictBox.textContent = '';
            return false;
        }

        const params = new URLSearchParams({
            maPhong: roomId,
            ngay: document.getElementById('editNgayHoc').value,
            ca: document.getElementById('editCaHoc').value,
            maHocPhan: document.getElementById('editMaHocPhan').value,
            maGiangVienDayThay: document.getElementById('editMaGiangVienDayThay').value,
            excludeLichHocId: document.getElementById('editMaLichHoc').value
        });
        try {
            const response = await fetch(`/LichHoc/CheckConflict?${params}`);
            if (!response.ok) throw new Error('Không kiểm tra được xung đột lịch.');
            const data = await response.json();
            if (requestId !== conflictCheckId) return false;
            conflictBox.textContent = data.conflict ? data.messages.join(' ') : '';
            conflictBox.classList.toggle('hidden', !data.conflict);
            return data.conflict;
        } catch (error) {
            if (requestId === conflictCheckId) {
                conflictBox.textContent = 'Chưa kiểm tra được xung đột. Hệ thống sẽ xác minh lại khi lưu.';
                conflictBox.classList.remove('hidden');
            }
            return false;
        }
    }

    document.querySelectorAll('.js-edit-lich').forEach(button => {
        button.addEventListener('click', async () => {
            document.getElementById('editMaLichHoc').value = button.dataset.id;
            document.getElementById('editMaHocPhan').value = button.dataset.maHocPhan;
            document.getElementById('editCourseTitle').textContent =
                `${button.dataset.tenHocPhan} (${button.dataset.maHocPhan}) · ${button.dataset.ngay} · ${button.dataset.ca}`;
            document.getElementById('editNgayHoc').value = button.dataset.ngay;
            document.getElementById('editCaHoc').value = button.dataset.ca;
            document.getElementById('editMaGiangVienDayThay').value = button.dataset.maGv || '';
            document.getElementById('editTrangThaiHoatDong').value = button.dataset.trangThai;
            document.getElementById('editGhiChuDieuPhoi').value = button.dataset.ghiChu || '';
            document.getElementById('editCancelButton').hidden = button.dataset.trangThai !== 'true';
            roomFilter.value = '';
            filterEditRooms(button.dataset.maPhong || '');
            roomSelect.required = button.dataset.trangThai === 'true';
            document.getElementById('cancelLichId').value = button.dataset.id;
            conflictBox.classList.add('hidden');
            editModal.showModal();
            await checkEditConflict();
        });
    });

    roomFilter.addEventListener('change', () => {
        filterEditRooms();
        checkEditConflict();
    });
    ['editMaPhong', 'editNgayHoc', 'editCaHoc', 'editMaGiangVienDayThay', 'editTrangThaiHoatDong']
        .forEach(id => document.getElementById(id).addEventListener('change', event => {
            if (id === 'editTrangThaiHoatDong') {
                roomSelect.required = event.target.value === 'true';
                document.getElementById('editCancelButton').hidden = event.target.value !== 'true';
            }
            checkEditConflict();
        }));
    editForm.addEventListener('submit', async event => {
        if (editSubmitting) return;
        event.preventDefault();
        const hasConflict = await checkEditConflict();
        if (!hasConflict) {
            editSubmitting = true;
            editForm.requestSubmit(event.submitter);
        }
    });

    function renumberCa() {
        document.querySelectorAll('#caBody tr').forEach((tr, i) => {
            tr.querySelectorAll('input').forEach(inp => {
                inp.name = inp.name.replace(/caHocs\[\d+\]/, 'caHocs[' + i + ']');
            });
        });
    }
    function themCa() {
        const i = document.querySelectorAll('#caBody tr').length;
        const tr = document.createElement('tr');
        tr.className = 'border-b border-surface-container last:border-0';
        tr.innerHTML =
            `<td class="p-1"><input name="caHocs[${i}].Code" placeholder="CA_..." class="w-28 rounded bg-surface-container-low px-2 py-1 font-mono" /></td>` +
            `<td class="p-1"><input name="caHocs[${i}].Label" placeholder="Tên ca" class="w-36 rounded bg-surface-container-low px-2 py-1" /></td>` +
            `<td class="p-1"><input name="caHocs[${i}].BatDau" placeholder="HH:mm" inputmode="numeric" maxlength="5" pattern="[0-2][0-9]:[0-5][0-9]" class="gio w-24 rounded bg-surface-container-low px-2 py-1 font-mono" /></td>` +
            `<td class="p-1"><input name="caHocs[${i}].KetThuc" placeholder="HH:mm" inputmode="numeric" maxlength="5" pattern="[0-2][0-9]:[0-5][0-9]" class="gio w-24 rounded bg-surface-container-low px-2 py-1 font-mono" /></td>` +
            `<td class="p-1"><input name="caHocs[${i}].Tiet" type="number" min="1" max="15" value="1" class="w-14 rounded bg-surface-container-low px-2 py-1" /></td>` +
            `<td class="p-1"><input name="caHocs[${i}].SoTiet" type="number" min="3" max="5" step="2" value="3" class="w-14 rounded bg-surface-container-low px-2 py-1" /></td>` +
            `<td class="p-1 text-center"><button type="button" onclick="xoaCa(this)" class="text-error" title="Xóa ca"><span class="material-symbols-outlined text-[18px]">delete</span></button></td>`;
        document.getElementById('caBody').appendChild(tr);
    }
    function xoaCa(btn) {
        if (document.querySelectorAll('#caBody tr').length <= 1) return;
        btn.closest('tr').remove();
        renumberCa();
    }

    // Chuẩn hóa giờ về dạng 24h hai chữ số: 7:00 / 7h / 700 -> 07:00.
    function chuanHoaGio(el) {
        var raw = el.value.trim().toLowerCase()
            .replace(/[hg.]/g, ':').replace(/[^0-9:]/g, '');
        var m = raw.match(/^(\d{1,2}):?(\d{1,2})?$/);
        if (!m) return;
        var h = Math.min(23, parseInt(m[1] || '0', 10));
        var mi = Math.min(59, parseInt(m[2] || '0', 10));
        el.value = String(h).padStart(2, '0') + ':' + String(mi).padStart(2, '0');
    }
    document.getElementById('caBody').addEventListener('focusout', function (e) {
        if (e.target.classList && e.target.classList.contains('gio')) chuanHoaGio(e.target);
    });
</script>
}
