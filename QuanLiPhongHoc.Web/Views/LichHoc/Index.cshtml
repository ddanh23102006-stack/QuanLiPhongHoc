        <form asp-action="CauHinhCaHoc" method="post" class="bg-surface-container-lowest">
            @Html.AntiForgeryToken()
            <input type="hidden" name="week" value="@weekStart.ToString("yyyy-MM-dd")" />
            <input type="hidden" name="building" value="@(building?.ToString() ?? "")" />
            <input type="hidden" name="loai" value="@loai" />
            <div class="bg-primary-container px-4 py-3 flex items-center justify-between text-on-primary rounded-t-xl">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-[20px]">schedule</span>
