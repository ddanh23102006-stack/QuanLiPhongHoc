                                    <td class="p-1"><input name="caHocs[@idx].KetThuc" value="@c.KetThuc" placeholder="HH:mm" inputmode="numeric" maxlength="5" pattern="[0-2][0-9]:[0-5][0-9]" title="Giờ 24h, ví dụ 17:25" class="gio w-24 rounded bg-surface-container-low px-2 py-1 font-mono" /></td>
