                                <th class="p-2 border-b border-surface-container font-semibold">Tên ca</th>
                                <th class="p-2 border-b border-surface-container font-semibold">Bắt đầu</th>
                                <th class="p-2 border-b border-surface-container font-semibold">Kết thúc</th>
                                <th class="p-2 border-b border-surface-container font-semibold">Tiết</th>
