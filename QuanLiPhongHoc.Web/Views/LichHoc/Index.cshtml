            <p class="text-sm text-on-surface-variant">Cập nhật giảng viên thay thế, phòng, giờ và trạng thái ca</p>
          </div>
          <button type="button" onclick="document.getElementById('lichEditModal').close()" aria-label="Đóng">
            <span class="material-symbols-outlined">close</span>
          </button>
        </div>
        <div class="p-5 space-y-4">
          <div class="rounded-lg border-l-4 border-primary bg-primary-container/30 p-3">
            <div class="text-xs font-semibold text-primary">Điều phối ca học có sẵn</div>
            <div id="editCourseTitle" class="mt-1 font-medium text-on-surface"></div>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <label class="block text-sm font-semibold">
              Thứ trong tuần
              <input type="date" name="NgayHoc" id="editNgayHoc" required class="mt-1 w-full rounded-lg border border-outline-variant bg-surface-container-low px-3 py-2" />
            </label>
            <label class="block text-sm font-semibold">
              Khung ca học
              <select name="CaHoc" id="editCaHoc" class="mt-1 w-full rounded-lg border border-outline-variant bg-surface-container-low px-3 py-2">
                @foreach (var ca in Catalogs.CaHocSettings)
                {
                  <option value="@ca.Code">@ca.Label (@ca.TimeRange)</option>
                }
              </select>
            </label>
          </div>
          <label class="block text-sm font-semibold">
            Giảng viên phụ trách / thay thế
            <select name="MaGiangVienDayThay" id="editMaGiangVienDayThay" class="mt-1 w-full rounded-lg border border-outline-variant bg-surface-container-low px-3 py-2">
              <option value="">Giảng viên chính của học phần</option>
              @foreach (var gv in giangVienOptions)
              {
                <option value="@gv.MaNguoiDung">@gv.HoTen (@gv.MaNguoiDung)</option>
