@model PhongHoc
@{
    ViewData["Title"] = Model.CodePhong;
    var canEdit = User.IsInRole(AppRoles.Facility);
    var thietBi = Model.PhongThietBis.ToList();
    string MauTrangThai(string tt) => tt switch
    {
        "GOOD" => "bg-tertiary-container/15 text-tertiary",
        "NEEDS_REPAIR" or "REPAIRING" => "bg-amber-50 text-amber-700 border border-amber-300",
        "RETIRED" => "bg-surface-container text-on-surface-variant",
        _ => "bg-error-container text-on-error-container"
    };
}
<div class="flex flex-wrap items-center justify-between gap-space-md mb-space-md">
  <div>
    <div class="text-xs text-on-surface-variant">
      CSVC / <a class="text-primary" href="/ToaNha">Tòa nhà</a>
      @if (Model.ToaNha != null)
      {
        <text> / <a class="text-primary" href="/ToaNha/Details/@Model.ToaNha.MaToaNha">@Model.ToaNha.CodeToaNha</a></text>
      }
      / <a class="text-primary" href="/PhongHoc">Phòng học</a> / <span class="font-bold">@Model.CodePhong</span>
    </div>
    <h1 class="text-xl font-bold">@Model.CodePhong</h1>
    <p class="text-sm text-on-surface-variant mt-1">@Model.ToaNha?.TenToaNha · @Catalogs.LabelLoaiPhong(Model.LoaiPhong) · @Model.SucChua chỗ · @Catalogs.LabelTrangThaiPhong(Model.TrangThaiPhong)</p>
  </div>
  <div class="flex flex-wrap items-center gap-2">
    @if (canEdit)
    {
      <a class="px-3 py-2 rounded-lg bg-tertiary-container text-on-tertiary font-semibold text-sm" href="/PhongHoc/XuatBaoCaoThietBi/@Model.MaPhong">Xuất báo cáo Excel</a>
    }
    <a class="px-3 py-2 rounded-lg bg-surface-container text-on-surface font-semibold text-sm" href="/PhongHoc">← Danh sách</a>
  </div>
</div>

@if (Model.ToaNha != null && Model.ToaNha.TrangThaiHoatDong != "ACTIVE")
{
  <div class="mb-space-md px-space-md py-2.5 rounded-lg bg-amber-50 text-amber-800 border border-amber-300 text-sm">
    Tòa nhà @Model.ToaNha.CodeToaNha đang @Catalogs.LabelTrangThaiToaNha(Model.ToaNha.TrangThaiHoatDong).ToLowerInvariant() — phòng này tạm không nhận lịch/mượn phòng.
  </div>
}

<div class="grid grid-cols-3 gap-space-md mb-space-md">
  <div class="bg-surface-container-lowest rounded-xl p-space-lg shadow-sm">
    <div class="text-xs uppercase text-on-surface-variant font-semibold">Thiết bị trong phòng</div>
    <div class="text-2xl font-bold mt-1">@thietBi.Count</div>
  </div>
  <div class="bg-surface-container-lowest rounded-xl p-space-lg shadow-sm">
    <div class="text-xs uppercase text-on-surface-variant font-semibold">Đang tốt</div>
    <div class="text-2xl font-bold text-tertiary mt-1">@thietBi.Count(x => x.TrangThai == "GOOD")</div>
  </div>
  <div class="bg-surface-container-lowest rounded-xl p-space-lg shadow-sm">
    <div class="text-xs uppercase text-on-surface-variant font-semibold">Cần xử lý</div>
    <div class="text-2xl font-bold text-error mt-1">@thietBi.Count(x => Catalogs.ThietBiCanXuLy(x.TrangThai))</div>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-space-md">
  <div class="lg:col-span-2 bg-surface-container-lowest rounded-xl shadow-sm overflow-x-auto">
    <div class="p-space-lg font-semibold">Danh sách thiết bị đang được phân bổ (@thietBi.Count)</div>
    <table class="w-full text-sm">
      <thead class="bg-surface-container"><tr><th class="p-3 text-left">Nhãn</th><th class="p-3 text-left">Thiết bị</th><th class="p-3 text-left">Trạng thái</th></tr></thead>
      <tbody>
      @foreach (var tb in thietBi)
      {
        <tr class="border-t border-surface-container align-top">
          <td class="p-3 font-semibold">@tb.NhanDienThietBi</td>
          <td class="p-3">
            <div>@tb.ThietBi?.TenThietBi</div>
            @if (!string.IsNullOrWhiteSpace(tb.ThietBi?.MaCodeThietBi))
            {
              <div class="text-xs text-on-surface-variant font-mono">@tb.ThietBi?.MaCodeThietBi</div>
            }
          </td>
          <td class="p-3">
            <span class="px-2 py-0.5 rounded text-xs font-semibold @MauTrangThai(tb.TrangThai)">@Catalogs.Label(Catalogs.TrangThaiThietBi, tb.TrangThai)</span>
            @if (canEdit)
            {
              <form asp-action="CapNhatThietBi" method="post" class="mt-1 flex items-center gap-1">
                <input type="hidden" name="maPhongThietBi" value="@tb.MaPhongThietBi" />
                <select name="trangThai" class="rounded bg-surface-container-low text-xs px-1.5 py-1">
                  @foreach (var tt in Catalogs.TrangThaiThietBi)
                  {
                    <option value="@tt.Key" selected="@(tt.Key == tb.TrangThai)">@tt.Value</option>
                  }
                </select>
                <button class="text-primary text-xs font-semibold">Lưu</button>
              </form>
            }
          </td>
        </tr>
      }
      @if (thietBi.Count == 0)
      {
        <tr><td colspan="3" class="p-6 text-center text-on-surface-variant">Phòng chưa được gán thiết bị nào.</td></tr>
      }
      </tbody>
    </table>
  </div>

  @if (canEdit)
  {
    <div class="bg-surface-container-lowest rounded-xl shadow-sm p-space-lg">
      <h2 class="font-semibold mb-space-md">Gán thiết bị vào phòng</h2>
      <form asp-controller="ThietBi" asp-action="Gan" method="post" class="space-y-space-md">
        <input type="hidden" name="MaPhong" value="@Model.MaPhong" />
        <div>
          <label class="block text-xs font-semibold text-on-surface-variant mb-1">Loại thiết bị</label>
          <select name="MaThietBi" id="sel-thiet-bi" class="w-full rounded-lg bg-surface-container-low px-3 py-2 text-sm">
            <option value="">Đang tải…</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold text-on-surface-variant mb-1">Nhãn nhận diện</label>
          <input name="NhanDienThietBi" placeholder="VD: Máy 01" class="w-full rounded-lg bg-surface-container-low px-3 py-2 text-sm" />
        </div>
        <div class="grid grid-cols-2 gap-space-md">
          <div>
            <label class="block text-xs font-semibold text-on-surface-variant mb-1">Số lượng</label>
            <input type="number" name="SoLuong" value="1" min="1" max="200" class="w-full rounded-lg bg-surface-container-low px-3 py-2 text-sm font-mono" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-on-surface-variant mb-1">Trạng thái</label>
            <select name="trangThai" class="w-full rounded-lg bg-surface-container-low px-3 py-2 text-sm">
              @foreach (var tt in Catalogs.TrangThaiThietBi)
              {
                <option value="@tt.Key">@tt.Value</option>
              }
            </select>
          </div>
        </div>
        <button type="submit" class="w-full px-4 py-2 rounded-lg bg-primary-container text-on-primary font-semibold text-sm">Gán vào phòng</button>
      </form>
      <p class="text-xs text-on-surface-variant mt-3">
        Mở <a class="text-primary font-semibold" href="/ThietBi">Thiết bị CSVC</a> để khai báo loại thiết bị mới trước khi gán vào phòng.
      </p>
    </div>
  }
</div>

@section Scripts {
<script>
  fetch('/ThietBi/Combobox?maPhong=@Model.MaPhong')
    .then(function (r) { return r.json(); })
    .then(function (list) {
      var sel = document.getElementById('sel-thiet-bi');
      if (!sel) return;
      sel.innerHTML = '<option value="">— Chọn thiết bị —</option>';
      list.forEach(function (t) {
        var o = document.createElement('option');
        o.value = t.maThietBi;
        o.textContent = (t.maCodeThietBi ? t.maCodeThietBi + ' · ' : '') + t.tenThietBi;
        sel.appendChild(o);
      });
    });
</script>
}
