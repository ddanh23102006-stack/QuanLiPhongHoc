                                </p>
                            </div>
                        }

                        <form asp-action="XuLy" method="post" class="js-xuly-form space-y-3 border-t border-surface-container pt-3">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="MaSuCo" value="@s.MaSuCo" />
                            <input type="hidden" name="ReturnUrl" value="@Trang(page)" />
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                                <div>
                                    <label class="block font-label-md text-label-md text-on-surface font-bold mb-1 text-[12px]" for="danhgia-@s.MaSuCo">Đánh giá sau kiểm tra:</label>
                                    <textarea id="danhgia-@s.MaSuCo" name="DanhGia" rows="2"
                                              class="w-full text-body-sm p-2.5 bg-surface border border-surface-container-highest rounded-lg focus:outline-none focus:border-primary text-on-surface"
                                              placeholder="VD: Bóng đèn hỏng do chấn lưu, đã thay thế.">@s.DanhGia</textarea>
                                </div>
                                <div class="space-y-2">
                                    <div>
                                        <label class="block font-label-md text-label-md text-on-surface font-bold mb-1 text-[12px]" for="trangthai-@s.MaSuCo">Cập nhật trạng thái sự cố:</label>
                                        <select id="trangthai-@s.MaSuCo" name="TrangThai" class="w-full py-2 px-3 text-body-sm bg-surface border border-surface-container-highest rounded-lg focus:outline-none focus:border-primary text-on-surface">
                                            @foreach (var kv in Catalogs.TrangThaiSuCo)
                                            {
                                                <option value="@kv.Key" selected="@(kv.Key == s.TrangThai)">@kv.Value</option>
                                            }
                                        </select>
                                    </div>
                                    <div>
                                        <label class="block font-label-md text-label-md text-on-surface font-bold mb-1 text-[12px]" for="ketqua-@s.MaSuCo">Kết quả gửi người báo cáo:</label>
                                        <select id="ketqua-@s.MaSuCo" name="KetQua" class="kq-select w-full py-2 px-3 text-body-sm bg-surface border border-surface-container-highest rounded-lg focus:outline-none focus:border-primary text-on-surface">
                                            <option value="">— Chỉ cập nhật đánh giá / trạng thái —</option>
                                            @foreach (var kv in Catalogs.KetQuaSuCo)
                                            {
                                                <option value="@kv.Key" selected="@(s.KetQuaXuLy == kv.Key)">@kv.Value</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="phong-dich hidden">
                                <label class="block font-label-md text-label-md text-on-surface font-bold mb-1 text-[12px]" for="phongdich-@s.MaSuCo">Phòng:</label>
