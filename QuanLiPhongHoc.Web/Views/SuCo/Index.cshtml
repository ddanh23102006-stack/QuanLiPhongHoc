                                        @foreach (var loai in phongDich.Select(x => x.LoaiPhong).Distinct())
                                        {
                                            <option value="@loai">@Catalogs.LabelLoaiPhong(loai)</option>
                                        }
                                    </select>
                                    <select id="phongdich-@s.MaSuCo" name="PhongDieuChuyen" class="w-full py-2 px-3 text-body-sm bg-surface border border-surface-container-highest rounded-lg focus:outline-none focus:border-primary text-on-surface">
                                        <option value="">— Chọn phòng —</option>
                                        @foreach (var p in phongDich)
                                        {
                                            <option value="@p.MaPhong" data-loai="@p.LoaiPhong" selected="@(s.PhongDieuChuyen == p.MaPhong)">@p.CodePhong</option>
                                        }
                                    </select>
                                </div>
                                <span class="dem-phong-dich text-[11px] text-secondary mt-0.5 block">Chọn loại phòng để lọc nhanh danh sách phòng.</span>
                            </div>
                            <div>
                                <label class="block font-label-md text-label-md text-on-surface font-bold mb-1 text-[12px]" for="thongbao-@s.MaSuCo">Nội dung thông báo gửi người báo cáo:</label>
                                <textarea id="thongbao-@s.MaSuCo" name="ThongBao" rows="3"
                                          class="w-full text-body-sm p-2.5 bg-surface border border-surface-container-highest rounded-lg focus:outline-none focus:border-primary text-on-surface leading-relaxed"
                                          placeholder="Để trống sẽ dùng nội dung mặc định theo kết quả.">@s.ThongBaoPhanHoi</textarea>
                                <span class="text-[11px] text-secondary mt-0.5 block">“Đã phục hồi” đưa thiết bị/phòng về trạng thái tốt; “Điều chuyển phòng” chuyển thiết bị sang phòng đã chọn. Thông báo hiển thị cho người báo cáo.</span>
                            </div>
                            <div class="flex flex-col sm:flex-row sm:items-center justify-end gap-2 border-t border-surface-container pt-3">
                                <button type="button" data-dong-modal class="px-4 py-1.5 bg-surface-container-lowest border border-outline-variant hover:bg-surface-container text-on-surface rounded-lg font-label-md text-label-md transition-colors">Đóng lại</button>
                                <button type="submit" class="px-5 py-2 bg-primary hover:bg-primary-container text-on-primary rounded-lg font-label-md text-label-md font-bold flex items-center justify-center gap-1.5 shadow transition-all">
                                    <span class="material-symbols-outlined text-[18px]">assignment_turned_in</span>
                                    <span>Lưu &amp; Gửi thông báo</span>
                                </button>
                            </div>
                        </form>

                        @if (!string.IsNullOrWhiteSpace(s.DanhGia) || s.NguoiXuLyNav != null)
                        {
                            <div class="rounded-lg bg-surface-container-low px-3 py-2 text-[12px] text-secondary">
                                Xử lý gần nhất bởi <b class="text-on-surface">@(s.NguoiXuLyNav?.HoTen ?? "CSVC")</b>
                                @if (s.NgayXuLy is DateTime ngay)
                                {
                                    <text>· @ngay.ToString("dd/MM/yyyy HH:mm")</text>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    @if (soTrang > 1)
    {
        <nav class="flex items-center justify-center gap-1.5 text-sm mt-4">
            @if (page > 1)
            {
                <a href="@Trang(page - 1)" class="px-3 py-1.5 rounded-lg border border-outline-variant text-on-surface-variant hover:bg-surface-container-low">‹ Trước</a>
            }
            @for (var p = 1; p <= soTrang; p++)
            {
                <a href="@Trang(p)" class="px-3 py-1.5 rounded-lg border @(p == page ? "bg-primary text-on-primary border-primary font-semibold" : "border-outline-variant text-on-surface-variant hover:bg-surface-container-low")">@p</a>
            }
            @if (page < soTrang)
            {
                <a href="@Trang(page + 1)" class="px-3 py-1.5 rounded-lg border border-outline-variant text-on-surface-variant hover:bg-surface-container-low">Sau ›</a>
            }
        </nav>
    }
}
else
