                            <p class="text-[11px] text-secondary mt-1 flex items-center gap-1">
                                <span class="material-symbols-outlined text-[14px]">zoom_in</span>
                                Nhấp vào ảnh để xem đầy đủ. Nếu ảnh không hiển thị, dùng “Mở ảnh gốc”.
                            </p>
                        </div>
                    }

                    <div class="rounded-lg bg-surface-container-low border border-surface-container px-3 py-2.5">
                        <div class="flex flex-wrap items-center gap-2 text-[12px]">
                            <span class="material-symbols-outlined text-[16px] text-primary">fact_check</span>
                            <b class="text-on-surface">Đánh giá &amp; xử lý của CSVC</b>
                            @if (s.NguoiXuLyNav != null)
                            {
                                <span class="text-secondary">· @s.NguoiXuLyNav.HoTen</span>
                            }
                            @if (s.NgayXuLy is DateTime ngayXuLy)
                            {
                                <span class="text-secondary">· @ngayXuLy.ToString("dd/MM/yyyy HH:mm")</span>
                            }
                            @if (s.KetQuaXuLy != null)
                            {
                                <span class="px-2 py-0.5 rounded font-semibold @(s.KetQuaXuLy == "RESTORED" ? "bg-tertiary-container/20 text-tertiary" : "bg-primary-fixed text-on-primary-fixed-variant")">@Catalogs.Label(Catalogs.KetQuaSuCo, s.KetQuaXuLy)</span>
                            }
                        </div>
                        <p class="text-body-sm text-on-surface mt-1">
                            @(string.IsNullOrWhiteSpace(s.DanhGia) ? "CSVC chưa cập nhật đánh giá cho báo cáo này." : s.DanhGia)
                        </p>
                        @if (s.PhongDieuChuyenNav != null)
                        {
                            <p class="mt-0.5 text-[12px] text-on-surface-variant">Phòng điều chuyển: <b>@s.PhongDieuChuyenNav.CodePhong</b></p>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(s.ThongBaoPhanHoi))
                    {
                        <div class="rounded-lg bg-tertiary-container/15 border border-tertiary/25 px-3 py-2.5">
                            <div class="flex items-center gap-2 text-[12px] font-semibold text-tertiary">
                                <span class="material-symbols-outlined text-[16px]">notifications_active</span>
                                Thông báo từ CSVC
                                @if (s.NgayXuLy is DateTime gui)
                                {
                                    <span class="font-normal text-on-surface-variant">· @gui.ToString("dd/MM/yyyy HH:mm")</span>
                                }
                            </div>
                            <p class="text-body-sm mt-1">@s.ThongBaoPhanHoi</p>
                        </div>
                    }

                    <div class="flex justify-end border-t border-surface-container pt-3">
                        <button type="button" data-dong-modal class="px-4 py-1.5 bg-surface-container-lowest border border-outline-variant hover:bg-surface-container text-on-surface rounded-lg font-label-md text-label-md transition-colors">Đóng lại</button>
                    </div>
                </div>
            </div>
        </div>
    }
}

<div id="lightboxAnh" class="fixed inset-0 z-[60] bg-inverse-surface/85 backdrop-blur-xs items-center justify-center p-4 hidden">
    <button type="button" data-dong-anh class="absolute top-4 right-4 w-10 h-10 rounded-full bg-surface-container-lowest/90 text-on-surface flex items-center justify-center hover:bg-surface-container-lowest transition-colors">
        <span class="material-symbols-outlined">close</span>
    </button>
    <div class="max-w-full max-h-full flex flex-col items-center gap-2">
        <img id="lightboxImg" src="" alt="Ảnh hiện trường sự cố" class="max-h-[82vh] max-w-full rounded-lg shadow-2xl object-contain bg-surface-container-lowest" />
        <p id="lightboxMoTa" class="text-on-primary text-body-sm text-center"></p>
    </div>
</div>

@section Scripts {
<script>
  (() => {
    const mo = id => {
      const el = document.getElementById(id);
      if (!el) return;
      el.classList.remove('hidden');
      el.classList.add('flex');
    };
    const dong = el => {
      if (!el) return;
      el.classList.add('hidden');
      el.classList.remove('flex');
    };

    document.querySelectorAll('[data-mo-modal]').forEach(btn => {
      btn.addEventListener('click', () => mo(btn.dataset.moModal));
    });
    document.querySelectorAll('[data-dong-modal]').forEach(btn => {
      btn.addEventListener('click', () => dong(btn.closest('.fixed.inset-0')));
    });
    document.querySelectorAll('.fixed.inset-0').forEach(el => {
      el.addEventListener('click', e => { if (e.target === el) dong(el); });
    });

    const lightbox = document.getElementById('lightboxAnh');
    const lightboxImg = document.getElementById('lightboxImg');
    const lightboxMoTa = document.getElementById('lightboxMoTa');
    document.querySelectorAll('.js-xem-anh').forEach(btn => {
      btn.addEventListener('click', e => {
        e.stopPropagation();
        lightboxImg.alt = btn.dataset.anhMoTa || 'Ảnh hiện trường sự cố';
        lightboxImg.src = btn.dataset.anh;
        lightboxMoTa.textContent = btn.dataset.anhMoTa || '';
        lightbox.classList.remove('hidden');
        lightbox.classList.add('flex');
      });
    });
    lightboxImg?.addEventListener('error', () => {
      lightboxMoTa.textContent = 'Không tải được ảnh đã gửi. Bấm “Mở ảnh gốc” trong chi tiết đơn để mở trực tiếp.';
    });
    const dongAnh = () => {
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
      lightboxImg.src = '';
    };
    lightbox?.addEventListener('click', e => {
      if (e.target === lightbox || e.target.closest('[data-dong-anh]')) dongAnh();
    });
    lightboxImg?.addEventListener('click', e => e.stopPropagation());

    document.addEventListener('keydown', e => {
      if (e.key !== 'Escape') return;
      if (!lightbox.classList.contains('hidden')) { dongAnh(); return; }
      document.querySelectorAll('.fixed.inset-0.flex').forEach(dong);
    });

    document.querySelectorAll('.js-xuly-form').forEach(form => {
      const kq = form.querySelector('.kq-select');
      const khoi = form.querySelector('.phong-dich');
      if (!kq || !khoi) return;
      const capNhat = () => khoi.classList.toggle('hidden', kq.value !== 'TRANSFERRED');
      kq.addEventListener('change', capNhat);
      capNhat();
    });

    document.querySelectorAll('.phong-dich').forEach(khoi => {
      const loc = khoi.querySelector('.loc-loai-phong');
      const chon = khoi.querySelector('select[name="PhongDieuChuyen"]');
      const dem = khoi.querySelector('.dem-phong-dich');
      if (!loc || !chon) return;

      const capNhat = () => {
        const loai = loc.value;
        let soPhong = 0;
        for (const opt of chon.options) {
          if (!opt.value) continue;
          opt.hidden = !!loai && opt.dataset.loai !== loai;
          if (!opt.hidden) soPhong++;
        }
        if (chon.selectedOptions[0]?.hidden) chon.value = '';
        if (dem) {
          dem.textContent = loai
            ? `${soPhong} phòng thuộc loại đã chọn.`
            : `${soPhong} phòng khả dụng. Chọn loại phòng để lọc nhanh danh sách.`;
        }
      };

      loc.addEventListener('change', capNhat);
      capNhat();
    });
  })();
</script>
}
