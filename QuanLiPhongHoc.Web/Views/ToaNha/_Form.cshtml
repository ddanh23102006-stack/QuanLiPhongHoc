@model ToaNhaFormVm
<div asp-validation-summary="ModelOnly" class="text-error text-sm mb-space-md"></div>
<div class="grid grid-cols-1 md:grid-cols-2 gap-space-md">
  <div>
    <label class="block text-xs font-semibold text-on-surface-variant mb-1">Mã tòa nhà <span class="text-error">*</span></label>
    <input asp-for="CodeToaNha" class="w-full rounded-lg bg-surface-container-low px-3 py-2 text-sm font-mono uppercase" placeholder="VD: A2" />
    <span asp-validation-for="CodeToaNha" class="text-error text-xs"></span>
  </div>
  <div>
    <label class="block text-xs font-semibold text-on-surface-variant mb-1">Tên tòa nhà <span class="text-error">*</span></label>
    <input asp-for="TenToaNha" class="w-full rounded-lg bg-surface-container-low px-3 py-2 text-sm" placeholder="VD: Tòa nhà Lý thuyết A2" />
    <span asp-validation-for="TenToaNha" class="text-error text-xs"></span>
  </div>
  <div class="md:col-span-2">
    <label class="block text-xs font-semibold text-on-surface-variant mb-1">Địa chỉ</label>
    <input asp-for="DiaChi" class="w-full rounded-lg bg-surface-container-low px-3 py-2 text-sm" placeholder="VD: 06 Trần Văn Ơn, Phường Phú Hòa, TP. Thủ Dầu Một" />
    <span asp-validation-for="DiaChi" class="text-error text-xs"></span>
  </div>
  <div>
    <label class="block text-xs font-semibold text-on-surface-variant mb-1">Số tầng</label>
    <input asp-for="SoTang" type="number" min="1" max="100" class="w-full rounded-lg bg-surface-container-low px-3 py-2 text-sm font-mono" placeholder="VD: 5" />
    <span asp-validation-for="SoTang" class="text-error text-xs"></span>
  </div>
  <div>
    <label class="block text-xs font-semibold text-on-surface-variant mb-1">Trạng thái hoạt động</label>
    <select asp-for="TrangThaiHoatDong" class="w-full rounded-lg bg-surface-container-low px-3 py-2 text-sm">
      @foreach (var kv in Catalogs.TrangThaiToaNha)
      {
        <option value="@kv.Key">@kv.Value</option>
      }
    </select>
    <p class="text-xs text-on-surface-variant mt-1">Tòa đang bảo trì hoặc ngừng hoạt động sẽ không cho mượn phòng.</p>
    <span asp-validation-for="TrangThaiHoatDong" class="text-error text-xs"></span>
  </div>
</div>
