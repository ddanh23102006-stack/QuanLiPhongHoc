@model IEnumerable<HocPhan>
@{
    ViewData["Title"] = "Học phần";
    var tuKhoa = ViewBag.Q as string ?? "";
    var loaiLop = ViewBag.LoaiLop as string ?? "";
    var trangThaiLich = ViewBag.TrangThaiLich as string ?? "";
    var coBoLoc = !string.IsNullOrWhiteSpace(tuKhoa) || !string.IsNullOrWhiteSpace(loaiLop)
                  || !string.IsNullOrWhiteSpace(trangThaiLich);
}
<div class="flex flex-wrap items-center justify-between gap-space-md mb-space-md">
  <div>
    <div class="text-xs text-on-surface-variant">Đào tạo / <span class="text-primary font-bold">Học phần</span></div>
    <h1 class="text-xl font-bold">Danh mục học phần</h1>
  </div>
  <div class="flex flex-wrap gap-2">
    <a class="px-3 py-2 rounded-lg bg-surface-container text-on-surface font-semibold text-sm" href="/LichHoc">
      <span class="material-symbols-outlined text-[18px] align-middle">arrow_back</span> Thời khóa biểu tuần
    </a>
    <a class="px-3 py-2 rounded-lg bg-surface-container text-on-surface font-semibold text-sm" href="/HocPhan/Import">
      <span class="material-symbols-outlined text-[18px] align-middle">upload_file</span> Nhập Excel
    </a>
    <a class="px-3 py-2 rounded-lg bg-tertiary text-on-tertiary font-semibold text-sm" href="/HocPhan/AutoSchedule">
      <span class="material-symbols-outlined text-[18px] align-middle">auto_awesome</span> Xếp lịch tự động
    </a>
    <a class="px-3 py-2 rounded-lg bg-primary-container text-on-primary font-semibold text-sm" href="/HocPhan/Create">+ Thêm học phần</a>
  </div>
</div>

<form class="flex flex-wrap items-end gap-3 mb-space-md bg-surface-container-lowest p-space-md rounded-xl" method="get">
  <label class="flex flex-col gap-1 text-xs font-semibold text-on-surface-variant">
    Mã hoặc tên học phần
    <input name="q" value="@tuKhoa" placeholder="Nhập từ khóa" class="rounded-lg bg-surface-container-low px-3 py-2 text-sm min-w-56" />
  </label>
  <label class="flex flex-col gap-1 text-xs font-semibold text-on-surface-variant">
    Loại lớp
    <select name="loaiLop" onchange="this.form.requestSubmit()" class="rounded-lg bg-surface-container-low px-3 py-2 text-sm min-w-44">
      <option value="" selected="@(loaiLop == "")">Tất cả</option>
      <option value="theory" selected="@(loaiLop == "theory")">Lý thuyết</option>
      <option value="practice" selected="@(loaiLop == "practice")">Thực hành</option>
    </select>
  </label>
  <label class="flex flex-col gap-1 text-xs font-semibold text-on-surface-variant">
    Trạng thái xếp lịch
    <select name="trangThaiLich" onchange="this.form.requestSubmit()" class="rounded-lg bg-surface-container-low px-3 py-2 text-sm min-w-48">
      <option value="" selected="@(trangThaiLich == "")">Tất cả trạng thái</option>
      <option value="scheduled" selected="@(trangThaiLich == "scheduled")">Đã xếp</option>
      <option value="unscheduled" selected="@(trangThaiLich == "unscheduled")">Chưa xếp</option>
    </select>
  </label>
  <button type="submit" class="px-4 py-2 bg-primary text-on-primary rounded-lg text-sm font-semibold">Lọc danh sách</button>
  @if (coBoLoc)
  {
    <a asp-controller="HocPhan" asp-action="Index" class="px-4 py-2 bg-surface-container text-on-surface rounded-lg text-sm font-semibold">Xóa bộ lọc</a>
  }
</form>

@{
  var importErrors = TempData["ImportErrors"] as List<ImportRowError>;
}
@if (importErrors is { Count: > 0 })
{
  <div class="bg-surface-container-lowest rounded-xl shadow-sm overflow-x-auto mb-space-md">
    <div class="p-space-lg font-semibold text-error">Một số dòng Excel chưa nhập được (@importErrors.Count dòng)</div>
    <table class="w-full text-sm">
      <thead class="bg-surface-container text-left"><tr><th class="p-3">Dòng</th><th class="p-3">Nội dung lỗi</th></tr></thead>
      <tbody>
      @foreach (var e in importErrors)
      {
        <tr class="border-t border-surface-container">
          <td class="p-3 font-mono">@e.Row</td>
          <td class="p-3 text-on-surface-variant">@e.Message</td>
        </tr>
      }
      </tbody>
    </table>
  </div>
}

<div class="bg-surface-container-lowest rounded-xl shadow-sm overflow-x-auto">
<table class="w-full text-sm">
  <thead class="bg-surface-container text-left">
    <tr>
      <th class="p-3">Mã học phần</th>
      <th class="p-3">Tên học phần</th>
      <th class="p-3">Sĩ số</th>
      <th class="p-3">Giảng viên</th>
      <th class="p-3">Loại lớp</th>
      <th class="p-3">Số lịch đã xếp</th>
      <th class="p-3"></th>
    </tr>
  </thead>
  <tbody>
  @foreach (var hp in Model)
  {
    var soLichDaXep = hp.LichHocs.Count(x => x.TrangThaiHoatDong);
    var daXep = soLichDaXep > 0;
    <tr class="border-t border-surface-container @(daXep ? "bg-emerald-50/60 hover:bg-emerald-100/70" : "bg-rose-50/60 hover:bg-rose-100/70")">
      <td class="p-3 font-semibold text-primary font-mono">@hp.MaHocPhan</td>
      <td class="p-3">@hp.TenHocPhan</td>
      <td class="p-3 font-mono">@hp.SoLuongDangKy</td>
      <td class="p-3">@(hp.GiangVien?.HoTen ?? "—") <span class="text-on-surface-variant text-xs">@hp.MaGiangVien</span></td>
      <td class="p-3">
        @if (hp.LaThucHanh)
        {
          <span class="px-2 py-0.5 rounded-full bg-surface-container-high text-tertiary text-xs font-semibold">Thực hành</span>
        }
        else
        {
          <span class="px-2 py-0.5 rounded-full bg-surface-container text-on-surface-variant text-xs font-semibold">Lý thuyết</span>
        }
        @if (!string.IsNullOrWhiteSpace(hp.NhomNganh))
        {
          <span class="block mt-1 text-xs text-on-surface-variant">@Catalogs.LabelNhomNganh(hp.NhomNganh)</span>
        }
      </td>
      <td class="p-3">
        <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-bold @(daXep ? "bg-emerald-100 text-emerald-800" : "bg-rose-100 text-rose-800")">
          <span class="h-2 w-2 rounded-full @(daXep ? "bg-emerald-600" : "bg-rose-600")"></span>
          @(daXep ? "Đã xếp" : "Chưa xếp")
        </span>
        <span class="ml-1 font-mono text-xs @(daXep ? "text-emerald-800" : "text-rose-800")">(@soLichDaXep ca)</span>
      </td>
      <td class="p-3 space-x-2 whitespace-nowrap">
        <a class="text-primary" href="/HocPhan/Edit/@hp.MaHocPhan">Sửa</a>
        <form asp-action="Delete" asp-route-id="@hp.MaHocPhan" method="post" class="inline" onsubmit="return confirm('Xóa học phần @hp.MaHocPhan?');">
          <button class="text-error">Xóa</button>
        </form>
      </td>
    </tr>
  }
  @if (!Model.Any())
  {
    <tr><td colspan="7" class="p-6 text-center text-on-surface-variant">Chưa có học phần nào. Hãy nhập từ Excel hoặc thêm mới.</td></tr>
  }
  </tbody>
</table>
</div>
