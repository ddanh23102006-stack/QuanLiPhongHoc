@model DashboardKpiDto?
<div class="bg-surface-container-lowest rounded-xl p-space-lg shadow-sm">
  <div class="text-xs uppercase text-on-surface-variant font-semibold">Tổng phòng</div>
  <div id="kpi-tong" class="text-2xl font-bold mt-1">@(Model?.TongPhong ?? 0)</div>
  <p class="text-xs text-on-surface-variant mt-1">Sẵn sàng: @(Model?.PhongSanSang ?? 0) · Bảo trì: @(Model?.PhongBaoTri ?? 0)</p>
</div>
<div class="bg-surface-container-lowest rounded-xl p-space-lg shadow-sm">
  <div class="text-xs uppercase text-on-surface-variant font-semibold">Lịch hôm nay</div>
  <div id="kpi-dung" class="text-2xl font-bold mt-1">@(Model?.LichHomNay ?? 0)</div>
  <p class="text-xs text-on-surface-variant mt-1">Tỷ lệ lấp đầy (ước lượng) @(Model?.TyLeLapDay ?? 0)%</p>
</div>
<div class="bg-surface-container-lowest rounded-xl p-space-lg shadow-sm">
  <div class="text-xs uppercase text-on-surface-variant font-semibold">Sự cố mới</div>
  <div id="kpi-suco" class="text-2xl font-bold text-error mt-1">@(Model?.SuCoMoi ?? 0)</div>
  <p class="text-xs text-on-surface-variant mt-1">Cần CSVC xử lý</p>
</div>
<div class="bg-surface-container-lowest rounded-xl p-space-lg shadow-sm">
  <div class="text-xs uppercase text-on-surface-variant font-semibold">Đơn chờ duyệt</div>
  <div id="kpi-cho" class="text-2xl font-bold text-error mt-1">@((Model?.DonDatCho ?? 0) + (Model?.DonNghiCho ?? 0))</div>
  <p class="text-xs text-on-surface-variant mt-1">Mượn phòng: @(Model?.DonDatCho ?? 0) · Nghỉ bù: @(Model?.DonNghiCho ?? 0)</p>
</div>
