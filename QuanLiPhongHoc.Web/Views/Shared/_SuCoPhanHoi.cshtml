@model IEnumerable<SuCo>
@{
    var ds = Model?.ToList() ?? [];
}
@if (ds.Count > 0)
{
  <section class="mb-6 rounded-xl border border-tertiary/30 bg-tertiary-container/10 overflow-hidden shadow-sm">
    <div class="px-5 py-3 flex flex-wrap items-center gap-2 border-b border-tertiary/20">
      <span class="material-symbols-outlined text-tertiary text-[20px]">notifications_active</span>
      <h2 class="font-bold text-slate-800">Phản hồi mới từ CSVC</h2>
      <span class="px-2 py-0.5 rounded-full bg-error-container text-on-error-container text-[11px] font-bold">@ds.Count</span>
      <a href="/SuCo" class="ml-auto text-xs text-primary hover:underline font-semibold">Xem tất cả ›</a>
    </div>
    <ul class="divide-y divide-tertiary/10">
      @foreach (var s in ds)
      {
        <li class="px-5 py-3">
          <div class="flex flex-wrap items-center gap-2 text-xs text-on-surface-variant">
            <b class="text-on-surface">@(s.PhongHoc?.CodePhong ?? "—")</b>
            <span>· @Catalogs.LabelLoaiSuCo(s.LoaiSuCo)</span>
            @if (s.KetQuaXuLy != null)
            {
              <span class="px-2 py-0.5 rounded font-semibold @(s.KetQuaXuLy == "RESTORED" ? "bg-tertiary-container/20 text-tertiary" : "bg-primary-fixed text-on-primary-fixed-variant")">@Catalogs.Label(Catalogs.KetQuaSuCo, s.KetQuaXuLy)</span>
            }
            @if (s.NgayXuLy is DateTime ngay)
            {
              <span class="ml-auto">@ngay.ToString("dd/MM/yyyy HH:mm")</span>
            }
          </div>
          <p class="text-sm mt-1">@s.ThongBaoPhanHoi</p>
        </li>
      }
    </ul>
    <div class="px-5 py-2 text-[11px] text-on-surface-variant bg-surface-container-low/40">
      Mở trang <a href="/SuCo" class="text-primary font-semibold hover:underline">Báo cáo sự cố</a> để xem chi tiết và đánh dấu đã đọc.
    </div>
  </section>
}
