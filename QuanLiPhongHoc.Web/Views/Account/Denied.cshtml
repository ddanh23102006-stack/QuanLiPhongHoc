@{
    ViewData["Title"] = "Không có quyền";
    var code = ViewBag.Code as int? ?? 403;
}
<div class="bg-surface-container-lowest rounded-xl p-space-xl shadow-sm max-w-2xl">
  <div class="flex items-center gap-3">
    <span class="material-symbols-outlined text-error text-[40px]">gpp_bad</span>
    <div>
      <h1 class="text-xl font-bold text-error">HTTP @code — Không đủ quyền truy cập</h1>
      <p class="mt-1 text-on-surface-variant">
        @if (code == 401)
        {
          <span>Phiên đăng nhập đã hết hiệu lực hoặc bạn chưa đăng nhập. Vui lòng đăng nhập lại.</span>
        }
        else if (code == 404)
        {
          <span>Không tìm thấy tài nguyên bạn yêu cầu.</span>
        }
        else
        {
          <span>Tài khoản của bạn không được phép truy cập chức năng này. Hệ thống phân quyền đã chặn yêu cầu.</span>
        }
      </p>
    </div>
  </div>
  <div class="flex gap-2 mt-space-lg">
    <a class="px-4 py-2 rounded-lg bg-primary-container text-on-primary font-semibold text-sm" href="/Home">Về trang chủ</a>
    <a class="px-4 py-2 rounded-lg bg-surface-container text-on-surface font-semibold text-sm" href="/Account/Logout">Đăng nhập lại</a>
  </div>
</div>
