@model ForgotPasswordViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Quên mật khẩu - TDMU ID</title>
  <script src="/lib/tailwind/tailwindcss.js"></script>
  <script>
    tailwind.config = { theme: { extend: { colors: { brand: { green: '#22a053', 'green-hover': '#1b8744', 'blue-link': '#0969da', field: '#ebf3fb' } } } } }
  </script>
  <style>
    .input-specimen { background:#ebf3fb; border:1px solid #c2dbf3; }
    .input-specimen:focus { background:#f4f8fe; border-color:#5ea3e6; box-shadow:0 0 0 3px rgba(94,163,230,.25); outline:none; }
  </style>
</head>
<body class="min-h-screen bg-[#f8fafc] text-slate-700 flex flex-col justify-between items-center px-4 py-8">
  <header class="w-full max-w-xl text-center pt-2 pb-6">
    <h1 class="text-xl md:text-2xl font-light text-slate-600 flex items-center justify-center gap-2">Kết nối với
      <img src="/img/logo-tdmu.png" class="w-7 h-7 object-contain" alt="Logo" />
    </h1>
    <p class="text-sm text-slate-500 mt-2">Khôi phục quyền truy cập Hệ thống Quản lý Phòng học qua <span class="font-medium text-slate-700">TDMU ID</span></p>
  </header>

  <main class="w-full max-w-[440px] my-auto">
    <div class="bg-white rounded-xl border border-slate-200 shadow-[0_4px_25px_-4px_rgba(0,0,0,0.06)] px-7 py-8 sm:px-9">
      <div class="flex flex-col items-center text-center">
        <img src="/img/logo-tdmu.png" class="w-24 h-24 object-contain mb-3" alt="Logo TDMU" />
        <h2 class="text-base font-semibold text-slate-800 mt-2 mb-2">Quên mật khẩu</h2>
        <p class="text-sm text-slate-500 mb-6">Nhập email hoặc mã tài khoản bạn đã đăng ký. Hệ thống sẽ gửi liên kết đặt lại mật khẩu đến email của tài khoản đó.</p>
      </div>

      @if (ViewBag.DaGui == true)
      {
        <div class="rounded-md border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
          Hướng dẫn đặt lại mật khẩu đã được gửi đến email của bạn nếu thông tin hợp lệ.
        </div>
        @if (ViewBag.LienKetDatLai != null)
        {
          <div class="mt-3 rounded-md border border-amber-200 bg-amber-50 px-4 py-3 text-xs text-amber-900">
            <div class="font-semibold mb-1">Môi trường phát triển chưa cấu hình SMTP — dùng liên kết dưới đây để đặt lại mật khẩu:</div>
            <a href="@ViewBag.LienKetDatLai" class="break-all text-[#0969da] underline">@ViewBag.LienKetDatLai</a>
            <div class="mt-2">Liên kết có hiệu lực 30 phút và chỉ dùng được một lần. Khi triển khai thật, cấu hình mục <code>Email</code> trong <code>appsettings.json</code> để gửi thư qua hộp thư.</div>
          </div>
        }
        <a asp-action="Login" class="mt-5 block w-full text-center bg-[#22a053] hover:bg-[#1b8845] text-white font-bold py-2.5 rounded-md text-sm uppercase tracking-wider">Về trang đăng nhập</a>
      }
      else
      {
        <form asp-action="ForgotPassword" method="post" class="space-y-4">
          <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm"></div>
          <div>
            <label asp-for="EmailHoacMa" class="block text-xs font-semibold text-slate-600 mb-1"></label>
            <input asp-for="EmailHoacMa" class="input-specimen block w-full rounded-md px-3.5 py-2.5 text-sm" placeholder="vd: sv202601@school.edu.vn hoặc SV202601" autofocus />
            <span asp-validation-for="EmailHoacMa" class="text-red-600 text-xs"></span>
          </div>
          <button type="submit" class="w-full bg-[#22a053] hover:bg-[#1b8845] text-white font-bold py-2.5 rounded-md text-sm uppercase tracking-wider">Gửi hướng dẫn đặt lại</button>
          <a asp-action="Login" class="block text-center text-sm text-[#0969da] hover:underline">Quay lại đăng nhập</a>
        </form>
      }
    </div>
  </main>

  <footer class="text-xs text-slate-400 py-4">© 2026 Trường Đại học Thủ Dầu Một (TDMU) - Cổng Quản lý Phòng học</footer>
</body>
</html>
