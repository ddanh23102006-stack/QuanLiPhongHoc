@model ResetPasswordViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Đặt lại mật khẩu - TDMU ID</title>
  <script src="/lib/tailwind/tailwindcss.js"></script>
  <script>
    tailwind.config = { theme: { extend: { colors: { brand: { green: '#22a053', 'green-hover': '#1b8744', 'blue-link': '#0969da', field: '#ebf3fb' } } } } }
  </script>
  <style>
    .input-specimen { background:#ebf3fb; border:1px solid #c2dbf3; }
    .input-specimen:focus { background:#f4f8fe; border-color:#5ea3e6; box-shadow:0 0 0 3px rgba(94,163,230,.25); outline:none; }
  </style>
</head>
<body class="min-h-screen bg-[#f8fafc] text-slate-700 flex flex-col justify-between items-center px-4 py-8">
  <header class="w-full max-w-xl text-center pt-2 pb-6">
    <h1 class="text-xl md:text-2xl font-light text-slate-600 flex items-center justify-center gap-2">Kết nối với
      <img src="/img/logo-tdmu.png" class="w-7 h-7 object-contain" alt="Logo" />
    </h1>
    <p class="text-sm text-slate-500 mt-2">Đặt lại mật khẩu tài khoản <span class="font-medium text-slate-700">TDMU ID</span></p>
  </header>

  <main class="w-full max-w-[440px] my-auto">
    <div class="bg-white rounded-xl border border-slate-200 shadow-[0_4px_25px_-4px_rgba(0,0,0,0.06)] px-7 py-8 sm:px-9">
      <div class="flex flex-col items-center text-center">
        <img src="/img/logo-tdmu.png" class="w-24 h-24 object-contain mb-3" alt="Logo TDMU" />
        <h2 class="text-base font-semibold text-slate-800 mt-2 mb-6">Tạo mật khẩu mới</h2>
      </div>

      @if (ViewBag.HopLe == true)
      {
        <form asp-action="ResetPassword" method="post" class="space-y-4">
          <input asp-for="Email" type="hidden" />
          <input asp-for="Token" type="hidden" />
          <p class="text-sm text-slate-500 -mt-2 mb-1">Tài khoản: <b class="text-slate-700">@Model.Email</b></p>
          <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm"></div>
          <div>
            <label asp-for="MatKhauMoi" class="block text-xs font-semibold text-slate-600 mb-1"></label>
            <input asp-for="MatKhauMoi" class="input-specimen block w-full rounded-md px-3.5 py-2.5 text-sm" placeholder="Tối thiểu 8 ký tự" autocomplete="new-password" autofocus />
            <span asp-validation-for="MatKhauMoi" class="text-red-600 text-xs"></span>
          </div>
          <div>
            <label asp-for="XacNhanMatKhau" class="block text-xs font-semibold text-slate-600 mb-1"></label>
            <input asp-for="XacNhanMatKhau" class="input-specimen block w-full rounded-md px-3.5 py-2.5 text-sm" placeholder="Nhập lại mật khẩu mới" autocomplete="new-password" />
            <span asp-validation-for="XacNhanMatKhau" class="text-red-600 text-xs"></span>
          </div>
          <button type="submit" class="w-full bg-[#22a053] hover:bg-[#1b8845] text-white font-bold py-2.5 rounded-md text-sm uppercase tracking-wider">Lưu mật khẩu mới</button>
        </form>
      }
      else
      {
        <div class="rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
          Liên kết đặt lại mật khẩu không hợp lệ hoặc đã hết hiệu lực. Vui lòng gửi lại yêu cầu mới.
        </div>
        <a asp-action="ForgotPassword" class="mt-5 block w-full text-center bg-[#22a053] hover:bg-[#1b8845] text-white font-bold py-2.5 rounded-md text-sm uppercase tracking-wider">Gửi lại yêu cầu</a>
        <a asp-action="Login" class="mt-3 block text-center text-sm text-[#0969da] hover:underline">Quay lại đăng nhập</a>
      }
    </div>
  </main>

  <footer class="text-xs text-slate-400 py-4">© 2026 Trường Đại học Thủ Dầu Một (TDMU) - Cổng Quản lý Phòng học</footer>
</body>
</html>
